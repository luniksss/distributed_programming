@page
@model Valuator.Pages.SummaryModel
@{
}
<p>
    @if (Model.IsRankComputed)
    {
        @:Оценка содержания: @Model.Rank
    }
    else
    {
        @:Оценка содержания не завершена
    }
</p>
<p>Плагиат: @Model.Similarity</p>

@if (!Model.IsRankComputed)
{
    <script src="~/js/centrifuge.js"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get('id');

        if (id) {
            const centrifuge = new Centrifuge('ws://localhost:8000/connection/websocket');
            const sub = centrifuge.newSubscription("notifications:" + id);

            sub.on('publication', function(ctx) {
                if (ctx.data.type === "RankCalculated") {
                    location.reload(); 
                }
            });

            sub.subscribe();
            centrifuge.connect();
        }
    </script>
}